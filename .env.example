# URL del API de publicación mensual (sin barra final). Vacío = datos locales.
# Solo se usa si está definida en el build; nunca la tome de la consulta del usuario.
# VITE_API_CATALOGO=https://api.ejemplo.ine.gob.gt
# API del portal (sesión, solicitudes y bandeja). Sin barra final.
# VITE_API_URL=http://localhost:3000
# Clave de sitio Cloudflare Turnstile. Vacío = clave de pruebas.
# VITE_TURNSTILE_SITE_KEY=
